# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# The CLI reads this file from the workspace root. Anything already exported in
# your shell wins over what is written here, so a one-off override still works.

# Personal access token for the tracker.
# Jira Server / Data Center: Profile → Personal Access Tokens.
JIRA_PAT=

# Optional. Only needed to pull from a private issue source.
GITHUB_TOKEN=

# Optional: values referenced by `${VAR}` in config.yml.
#
# A hostname and a project key are not secrets, but they are the parts of
# config.yml that identify a customer — and config.yml is committed. Referencing
# them here keeps the committed file free of anything identifying, which for a
# shared or public repository is the difference between being able to commit it
# and not. An undefined variable fails loudly rather than becoming an empty
# string.
#
# JIRA_BASE_URL=https://jira.example.com
# JIRA_PROJECT=PROJ
