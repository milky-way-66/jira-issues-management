{
  "name": "jira-issues-management",
  "version": "0.2.1",
  "description": "Manage Jira tickets and external GitHub issues as Markdown files in git, with a safe two-way sync",
  "type": "module",
  "license": "MIT",
  "repository": "github:milky-way-66/jira-issues-management",
  "bin": {
    "mgmt": "./dist/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "boundaries": "depcruise src --config .dependency-cruiser.json",
    "scan": "node scripts/scan-identifiers.mjs",
    "trace": "node scripts/traceability.mjs",
    "trace:gaps": "node scripts/traceability.mjs --gaps",
    "check": "npm run typecheck && npm run boundaries && npm run test && npm run trace && npm run scan",
    "version": "node scripts/sync-version.mjs && git add src/adapters/workspace.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check && npm run build",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^2.1.8",
    "dependency-cruiser": "^16.9.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
